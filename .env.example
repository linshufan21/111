# 复制为 .env 后按需导出到当前 shell；启动脚本不会自动加载 .env。
PORT=8787
# 本地默认 127.0.0.1；容器/反向代理内需设为 0.0.0.0。
# HOST=0.0.0.0
APP_URL=http://127.0.0.1:8787
# 默认 server/data/app.db；容器内通常为 /data/app.db。
# DB_PATH=/data/app.db
# 默认读取 package.json；发布脚本/容器构建参数会覆盖。
# APP_VERSION=0.1.0
# 可选：部署的提交 SHA，会出现在 /healthz 与日志中。
# GIT_SHA=

NODE_ENV=development
DEV_MAIL=1
REQUIRE_VERIFIED_TO_POST=1

MAIL_FROM="大家来决定 <noreply@dajia.local>"
# 生产邮件：Brevo 免费 300 封/天，或 Resend 免费 100 封/天。二选一。
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=
# RESEND_API_KEY=

# 反向代理（Nginx/Caddy 等）后设为 1，才会信任 X-Forwarded-Proto / X-Forwarded-For。
# 直接暴露公网或本地直连时保持 0，避免伪造来源 IP。
TRUST_PROXY=0

# CSRF 签名密钥。生产建议设置稳定随机值（至少 32 字节）；未设置时进程内随机生成。
# CSRF_SECRET=replace-with-a-long-random-secret

# CSP 报告地址（可选）；未设置时 report-only 违规只出现在浏览器控制台。
# CSP_REPORT_URI=https://example.com/csp-report

# 内容安全：词表路径、每字段最多链接数、发帖日限、投票分钟限。
# 频控设为 0 表示关闭；词表只做归一化后的子串匹配。
BLOCKLIST_PATH=config/blocklist.txt
MAX_LINKS_PER_FIELD=2
POST_DAILY_LIMIT=5
VOTE_RATE_LIMIT=20

# 通知 worker：每分钟扫描一次已截止问题；设为 0 可关闭（测试环境自动关闭）。
NOTIFY_WORKER=1

# 测试环境默认静默请求日志；设为 1 可在测试中查看 JSON 日志。
# LOG_REQUESTS=0

# 备份与 CSV 导出目录。
# BACKUP_DIR=backups
# BACKUP_RETENTION_DAYS=14
# EXPORT_DIR=exports

# Cookie Secure 覆盖：默认按 HTTPS / production 自动判断。
# 本地 HTTP 容器可显式设为 0；公网必须使用 HTTPS 并设为 1。
# COOKIE_SECURE=0

# 应用层 HSTS 开关：Nginx 生产配置负责 HSTS 时可设为 0，避免重复。
# HSTS=0

# 真实 SMTP 发信在 Day 21 接入；当前留空时使用控制台 + /dev/mail。
# SMTP_URL=smtp://user:password@smtp.example.com:587
