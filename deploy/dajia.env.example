# 复制为 /etc/dajia/dajia.env，权限 0600，属主 root:root。
# 不要把这个文件提交到 git。

NODE_ENV=production
HOST=127.0.0.1
PORT=8787
APP_URL=https://__DOMAIN__
DB_PATH=/var/lib/dajia/app.db
BACKUP_DIR=/var/lib/dajia/backups
EXPORT_DIR=/var/lib/dajia/exports
BLOCKLIST_PATH=/opt/dajia/config/blocklist.txt

# 至少 32 字符随机值：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=__CSRF_SECRET__

# 由 Caddy 终止 TLS；HSTS 由 Caddy 发送，应用层关闭避免重复。
COOKIE_SECURE=1
TRUST_PROXY=1
HSTS=0

DEV_MAIL=0
REQUIRE_VERIFIED_TO_POST=1
NOTIFY_WORKER=1
MAIL_FROM="大家来决定 <noreply@__MAIL_DOMAIN__>"

# 免费邮件额度：Brevo 300 封/天 或 Resend 100 封/天。二选一。
MAIL_PROVIDER=brevo
BREVO_API_KEY=__BREVO_API_KEY__
# RESEND_API_KEY=
